generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaySchedule {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PaymentStatus {
  SCHEDULED
  PAID
  MISSED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  paySchedule   PaySchedule
  paydayAnchor  DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  incomeSources IncomeSource[]
  bills         Bill[]
  suggestions   SplitSuggestion[]
}

model IncomeSource {
  id           String      @id @default(cuid())
  userId       String
  name         String
  amount       Decimal
  frequency    PaySchedule
  nextPayDate  DateTime

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Bill {
  id              String            @id @default(cuid())
  userId          String
  name            String
  amount          Decimal
  dueDate         Int               // day of month, 1-31
  category        String?
  isRecurring     Boolean           @default(true)
  splittable      Boolean           @default(false)
  minSplitAmount  Decimal?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]
  suggestions     SplitSuggestion[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  amount          Decimal
  paidDate        DateTime?
  status          PaymentStatus @default(SCHEDULED)
  isSplitPayment  Boolean       @default(false)
  splitGroupId    String?

  bill            Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SplitSuggestion {
  id              String    @id @default(cuid())
  userId          String
  billId          String
  suggestedSplit  Boolean
  reasoning       String
  suggestedDates  DateTime[]
  confidence      Float

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
}

model AIUsageLog {
  id        String   @id @default(cuid())
  date      String   // "2026-07-20" format, one row per day
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

model AICoachingCache {
  id        String   @id @default(cuid())
  userId    String
  dataHash  String
  coaching  String
  createdAt DateTime @default(now())

  @@unique([userId])
}